# Kakao channel settings
# Keep true for local scaffolding/tests. Set to false in real runtime.
KAKAO_DRY_RUN=true

# Required when KAKAO_DRY_RUN=false
KAKAO_REST_API_KEY=
KAKAO_WEBHOOK_SECRET=local-dev-webhook-secret
KAKAO_CHANNEL_TOKEN=

# Optional sandbox/override endpoints
KAKAO_API_BASE_URL=
KAKAO_WEBHOOK_BASE_URL=

# Local example app
EXAMPLE_PORT=8787
EXAMPLE_WEBHOOK_PATH=/webhooks/kakao
EXAMPLE_CHANNEL_ID=room-demo
EXAMPLE_USER_ID=user-demo
EXAMPLE_TEXT=hello from local simulate
